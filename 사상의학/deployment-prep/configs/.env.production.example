# =============================================================
# sasang-platform — 프로덕션 환경변수 템플릿
# =============================================================
# 사용법:
# 1. 이 파일을 그대로 복사해서 값만 채우기 (로컬 저장용)
# 2. Vercel 대시보드 → Settings → Environment Variables 에 하나씩 입력
# 3. 절대로 이 파일을 채운 채로 GitHub에 커밋하지 말 것!
#    (.gitignore에 .env.production 추가되어 있는지 확인)

# -------------------------------------------------------------
# 데이터베이스 (Turso libSQL)
# -------------------------------------------------------------
# 발급: turso db create sasang-prod 실행 결과
TURSO_DATABASE_URL=libsql://sasang-prod-kimhungtae.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# -------------------------------------------------------------
# 인증 (Auth.js v5)
# -------------------------------------------------------------
# AUTH_SECRET: openssl rand -base64 32 또는 PowerShell로 생성
AUTH_SECRET=base64-encoded-32-byte-string-here
AUTH_URL=https://sasang.onnuriclinic.com
AUTH_TRUST_HOST=true

# -------------------------------------------------------------
# 이메일 (Resend)
# -------------------------------------------------------------
# Resend 대시보드 → API Keys 에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=사상온누리 <noreply@onnuriclinic.com>

# -------------------------------------------------------------
# 사이트 게이트 (1차 비밀번호 보호)
# -------------------------------------------------------------
# 강력한 임의 문자열. 한의사들에게만 안전한 채널로 공유.
SITE_PASSWORD=change-this-to-strong-password
# 게이트 통과 후 쿠키 유효 기간(일)
SITE_GATE_DAYS=30

# -------------------------------------------------------------
# 운영자
# -------------------------------------------------------------
# 이 이메일로 가입 시 자동 admin 권한 부여
ADMIN_EMAIL=epaphrokim@gmail.com

# -------------------------------------------------------------
# 검색 엔진 (MeiliSearch) — Phase 3부터 사용
# -------------------------------------------------------------
# Fly.io 자체 호스팅: https://your-meili.fly.dev
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_SEARCH_KEY=

# -------------------------------------------------------------
# 파일 저장 (Cloudflare R2) — Phase 3부터 사용
# -------------------------------------------------------------
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sasang-sources

# -------------------------------------------------------------
# 분석 (선택)
# -------------------------------------------------------------
# Vercel Analytics는 환경변수 불필요 (자동)
# Plausible 등 사용 시 ID 추가
NEXT_PUBLIC_ANALYTICS_ID=

# -------------------------------------------------------------
# 운영 모드
# -------------------------------------------------------------
# 'internal' (사이트 비밀번호 ON) | 'public' (해제)
SITE_MODE=internal
